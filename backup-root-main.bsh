#!/bin/bash
# Backup of the newest btrfs root snapshot to ZFS.
#
# BACKUP_ROOT holds exactly ONE backup directory, named after the snapshot it
# reflects (e.g. 2026-11-23T01:11:26UTC). During a run it is renamed to
# <snapshot>.inWork, so an incomplete backup is visible as such - also inside
# any ZFS snapshot taken meanwhile. The previous backup is reused as rsync base,
# so only changed data is written. History/retention = ZFS snapshots.
set -euo pipefail
export LC_ALL=C   # byte-wise sorting/comparison of ISO timestamps

source "$(dirname "$0")/lib/lock.lib.bsh"       # provides: lock
source "$(dirname "$0")/lib/messages.lib.bsh"   # provides: vrb, inf, wrn, err (err exits 1)
source "$(dirname "$0")/lib/success.lib.bsh"    # provides success file handler

inf === === Backup of Snapshot of Root Partition === ===

lock

BACKUP_ROOT="/tank/backupSystems/main"
SNAPSHOT_ROOT="/mnt/root-snapshots"
DATE_RE='[0-9]{4}-[0-9]{2}-[0-9]{2}T[^/]*'   # starts with a date, e.g. 2026-11-23T01:11:26UTC[.inWork]

###############################################################################
# List entries in $1 whose name starts with a date, sorted chronologically
# (ISO timestamps: lexical order == chronological order)
###############################################################################
list_dated() {
    find "$1" -mindepth 1 -maxdepth 1 -type d \
         -regextype posix-extended -regex ".*/${DATE_RE}" -printf '%f\n' \
        | sort
}

[[ -d "$SNAPSHOT_ROOT" ]] || err "$SNAPSHOT_ROOT does not exist"
[[ -d "$BACKUP_ROOT"   ]] || err "$BACKUP_ROOT does not exist"

###############################################################################
# Source: newest snapshot
###############################################################################
snapshot="$(list_dated "$SNAPSHOT_ROOT" | tail -n1)"
[[ -n "$snapshot" ]] || err "No snapshot found in $SNAPSHOT_ROOT"

target="$BACKUP_ROOT/$snapshot"
work="$target.inWork"

inf "Source snapshot: $snapshot"

###############################################################################
# Previous backup: zero or exactly one expected
###############################################################################
mapfile -t old < <(list_dated "$BACKUP_ROOT")

if (( ${#old[@]} > 1 )); then
    err "More than one backup in $BACKUP_ROOT (${old[*]}) - clean up manually"
fi

if (( ${#old[@]} == 0 )); then
    wrn "No previous backup found in $BACKUP_ROOT - creating full backup"
    mkdir -- "$work"
else
    oldbak="${old[0]}"
    base="${oldbak%.inWork}"
    inf "Last backup:     $oldbak"

    if [[ "$base" > "$snapshot" ]]; then
        err "Last backup $oldbak is newer than newest snapshot $snapshot"
    fi

    if [[ "$oldbak" == *.inWork ]]; then
        wrn "$oldbak found - last backup run did not complete and may be broken. Reusing it as base; rsync brings it fully up to date"
    elif [[ "$base" == "$snapshot" ]]; then
        wrn "$snapshot already backed up. exiting cleanly."
        exit 0
    fi

    if [[ "$oldbak" != "$snapshot.inWork" ]]; then
        inf "Renaming $oldbak -> $snapshot.inWork"
        mv -T -- "$BACKUP_ROOT/$oldbak" "$work"
    fi
fi

###############################################################################
# Backup
#   --inplace --no-whole-file : rewrite only changed blocks of changed files
#                               (local rsync defaults to whole-file + temp file,
#                               which makes ZFS snapshots hold full file copies)
#   --numeric-ids             : keep raw uid/gid, correct on restore elsewhere
#   --delete-excluded         : drop files that are excluded now but were copied earlier
#   -S together with --inplace needs rsync >= 3.1.3
###############################################################################
inf "rsync $SNAPSHOT_ROOT/$snapshot/ -> $work/"

rsync -aHAXS --numeric-ids \
    --inplace --no-whole-file \
    --delete --delete-excluded \
    --exclude={"/dev/*","/proc/*","/sys/*","/tmp/*","/run/*","/mnt/*","/media/*","/lost+found"} \
    "$SNAPSHOT_ROOT/$snapshot/" \
    "$work/"

inf "Renaming $snapshot.inWork -> $snapshot"
mv -T -- "$work" "$target"

success
inf === === done === ===
